<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Название фигуры -->
    <TextView
        android:id="@+id/tv_piece_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пешка"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Изображение фигуры -->
    <ImageView
        android:id="@+id/iv_piece"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_pawn"
        android:contentDescription="Шахматная фигура"
        android:layout_marginBottom="24dp" />

    <!-- Изображение хода фигуры -->
    <ImageView
        android:id="@+id/iv_move_diagram"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:src="@drawable/pawn_move"
        android:contentDescription="Как ходит фигура"
        android:layout_marginBottom="24dp" />

    <!-- Описание -->
    <TextView
        android:id="@+id/tv_piece_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пешка ходит вперед на одну клетку, но бьет по диагонали."
        android:textSize="16sp"
        android:textColor="@color/secondary"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:lineSpacingExtra="4dp" />

    <!-- Панель переключения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <!-- Кнопка назад -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Назад"
            android:layout_marginEnd="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Индикатор текущей позиции -->
        <TextView
            android:id="@+id/tv_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <!-- Кнопка вперед -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вперед →"
            android:layout_marginStart="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />


    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_home"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Закрыть урок"
        android:layout_marginEnd="16dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>